# Copy this file to .env and fill in your values. Never commit .env (it is git-ignored).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend origins allowed to call the API with cookies (comma-separated, https in production)
CORS_ORIGINS=http://localhost:5173

# How many proxies sit in front of the API: 0 on your PC, usually 1 on Render/Railway.
# Rate limits use it to count the real visitor's IP instead of the proxy's.
TRUST_PROXY_HOPS=0

# Global rate limit: requests per IP per window (15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Largest JSON body the API accepts (protects against huge payloads)
JSON_BODY_LIMIT=10kb

# PostgreSQL on Neon (Neon dashboard → Connect). Copy BOTH strings:
#  - DATABASE_URL: "Connection pooling" ON  (host contains -pooler) → used by the running app
#  - DIRECT_URL:   "Connection pooling" OFF                       → used by migrations
# In DATABASE_URL, change sslmode=require to sslmode=verify-full (same strict certificate check, no driver warning).
DATABASE_URL=
DIRECT_URL=

# Redis on Upstash — Upstash console → your database → copy the URL with the copy button
# (the text on screen hides the password). It must start with rediss:// — Upstash refuses plain redis://.
REDIS_URL=

# --- Sign-in (milestone 3) ---
# The frontend's address, used in links inside emails (https in production).
APP_URL=http://localhost:5173
# Stricter per-IP limit for sign-in, sign-up and code emails (requests per 15 minutes).
AUTH_RATE_LIMIT_MAX=30
# "outbox" prints emails (with codes) in the API terminal. Development only; a real provider comes in milestone 9.
EMAIL_PROVIDER=outbox
# City/country for "Where you're signed in": none | vercel | cloudflare. Only set it when the API really runs
# behind that provider (otherwise visitors could fake the headers). "none" on your PC.
GEO_HEADERS=none

# --- Google sign-in (optional; "Continue with Google" is hidden when empty) ---
# Google Cloud console → Google Auth Platform → Clients → your Web client. Never commit these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed in the client's "Authorized redirect URIs". Default: APP_URL + /api/v1/auth/google/callback.
# Before the frontend exists, use the API directly: http://localhost:4000/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- PayMongo (milestone 5b), test mode. Empty = online payments off (cash on delivery still works). ---
# Secret test key from the PayMongo dashboard: Developers → API keys (starts with sk_test_). Never commit it.
PAYMONGO_SECRET_KEY=
# The webhook's own secret (whsk_…), shown when the webhook is created at deploy. Empty = webhooks refused.
PAYMONGO_WEBHOOK_SECRET=

# --- Cloudinary (milestone 6a): store logos, product photos, private verification documents. Empty = uploads off. ---
# Dashboard → API Keys → "API environment variable" (cloudinary://<key>:<secret>@<cloud name>). Never commit it.
CLOUDINARY_URL=

# --- Vendora AI (milestone 8). Empty = the assistant is off. ---
# Claude Console → API keys (sk-ant-…). Set a monthly spend limit there too. Never commit it.
ANTHROPIC_API_KEY=
# The Claude model that answers (default claude-opus-5-5).
AI_MODEL=
# Spending cap per Philippine day in US dollars (default 2). When reached, the assistant rests until midnight.
AI_DAILY_BUDGET_USD=
# Secret keys: run `npm run secrets` to fill these in with random values (never shown, never commit them).
# Changing ACCESS_TOKEN_SECRET or CSRF_SECRET signs everyone out.
ACCESS_TOKEN_SECRET=
CSRF_SECRET=
CODE_HASH_SECRET=
# Encrypts 2FA secrets in the database. Never change it once in use: existing 2FA set-ups couldn't be read.
DATA_ENCRYPTION_KEY=
