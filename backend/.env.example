# Copy this file to .env and fill in your values. Never commit .env (it is git-ignored).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend origins allowed to call the API with cookies (comma-separated, https in production)
CORS_ORIGINS=http://localhost:5173

# How many proxies sit in front of the API: 0 on your PC, usually 1 on Render/Railway.
# Rate limits use it to count the real visitor's IP instead of the proxy's.
TRUST_PROXY_HOPS=0

# Global rate limit: requests per IP per window (15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Largest JSON body the API accepts (protects against huge payloads)
JSON_BODY_LIMIT=10kb

# PostgreSQL on Neon (Neon dashboard → Connect). Copy BOTH strings:
#  - DATABASE_URL: "Connection pooling" ON  (host contains -pooler) → used by the running app
#  - DIRECT_URL:   "Connection pooling" OFF                       → used by migrations
# In DATABASE_URL, change sslmode=require to sslmode=verify-full (same strict certificate check, no driver warning).
DATABASE_URL=
DIRECT_URL=

# Redis on Upstash — Upstash console → your database → copy the URL with the copy button
# (the text on screen hides the password). It must start with rediss:// — Upstash refuses plain redis://.
REDIS_URL=

# --- Sign-in (milestone 3) ---
# The frontend's address, used in links inside emails (https in production).
APP_URL=http://localhost:5173
# Stricter per-IP limit for sign-in, sign-up and code emails (requests per 15 minutes).
AUTH_RATE_LIMIT_MAX=30
# "outbox" prints emails (with codes) in the API terminal. Development only; a real provider comes in milestone 9.
EMAIL_PROVIDER=outbox
# Secret keys: run `npm run secrets` to fill these in with random values (never shown, never commit them).
# Changing ACCESS_TOKEN_SECRET or CSRF_SECRET signs everyone out.
ACCESS_TOKEN_SECRET=
CSRF_SECRET=
CODE_HASH_SECRET=
