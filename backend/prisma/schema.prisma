// Vendora database schema — see docs/database-design.md for the reasoning.
// Conventions: UUID v7 ids, money in whole centavos (Int), timestamps with time zone,
// table names snake_case plural, columns camelCase. Extra CHECK constraints that
// Prisma can't express live at the end of the first migration's SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ============================ enums ============================

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OAuthProvider {
  GOOGLE
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
  REAUTH // "Confirm it's you" code for accounts without a password
}

enum SecurityEventType {
  LOGIN_OK
  LOGIN_FAILED
  LOCKED
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_CHANGED
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  BACKUP_CODE_USED
  BACKUP_CODES_RENEWED
  SESSION_REVOKED
  TOKEN_REUSE_DETECTED
  GOOGLE_CONNECTED
  GOOGLE_DISCONNECTED
  PAYOUT_ACCOUNT_CHANGED
}

enum StoreStatus {
  DRAFT // being set up ("Save and exit"); not yet submitted for review
  PENDING
  APPROVED
  REJECTED // final
  SUSPENDED
  CHANGES_REQUESTED // back with the seller: an admin asked for changes (7a); "Submit again" → PENDING
}

/// What an admin may do (7a): an admin holds at least one (CHECK).
enum AdminRole {
  SUPPORT // seller applications, payout accounts, users, stores
  FINANCE // payouts, refunds
  MODERATION // listings, warnings
}

enum BusinessType {
  INDIVIDUAL
  REGISTERED_BUSINESS
}

enum DocumentType {
  GOV_ID
  DTI_CERT
  SEC_CERT
  BIR_2303
  SELFIE
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PayoutMethod {
  BANK
  GCASH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  REMOVED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  GCASH
  MAYA
  CARD
  COD
}

enum SellerOrderStatus {
  AWAITING_PAYMENT
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

/// Who cancelled a paid package (unpaid orders that simply expired have none).
enum CancelledBy {
  SELLER
  BUYER
  SYSTEM
}

/// Why a paid package was cancelled. NOT_SHIPPED_IN_TIME is the automatic one (3 days after ship-by).
enum CancelReason {
  OUT_OF_STOCK
  CANNOT_SHIP_TO_ADDRESS
  BUYER_ASKED
  BUYER_CANCELLED
  NOT_SHIPPED_IN_TIME
}

/// Why money goes back: a cancelled package, a second payment for a paid order, or a late payment for sold-out items.
enum RefundReason {
  PACKAGE_CANCELLED
  DUPLICATE_PAYMENT
  LATE_PAYMENT_SOLD_OUT
}

/// PENDING: waiting to be sent (or retried) · SENT: PayMongo accepted it · FAILED: gave up after 3 days, needs a manual refund.
/// How a SENT refund reached the shopper: our PayMongo call, a refund an admin made in PayMongo's dashboard
/// (its id checked with PayMongo), or another transfer (e.g. GCash) with its reference (milestone 7b).
enum RefundSentVia {
  PAYMONGO_API
  PAYMONGO_DASHBOARD
  OTHER_TRANSFER
}

enum RefundStatus {
  PENDING
  SENT
  FAILED
}

/// Who confirmed a delivery: the buyer ("Order received") or the automatic confirmation 7 days after shipping.
enum DeliveryConfirmation {
  BUYER
  AUTO
}

enum DeliveryOption {
  STANDARD
  EXPRESS
}

enum PaymentProvider {
  PAYMONGO
  COD
}

enum PaymentStatus {
  PENDING
  AWAITING_ACTION
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum LedgerType {
  SALE
  FEE
  REFUND
  PAYOUT
  ADJUSTMENT
}

enum PayoutStatus {
  PROCESSING
  PAID
  FAILED
}

enum FlagSource {
  BUYER_REPORT
  AI
}

enum FlagStatus {
  OPEN
  KEPT
  REMOVED
}

// ==================== 1 · accounts & security ====================

model User {
  id                 String      @id @default(uuid(7)) @db.Uuid
  email              String      @unique @db.VarChar(254) // always lowercase (CHECK)
  emailVerifiedAt    DateTime?   @db.Timestamptz(3)
  passwordHash       String?     @db.VarChar(255) // Argon2id (PHC string); null for Google-only accounts
  name               String      @db.VarChar(100)
  phone              String?     @db.VarChar(20)
  role               Role        @default(CUSTOMER)
  /// ADMIN accounts only (CHECK): what this admin may do.
  adminRoles         AdminRole[] @default([])
  status             UserStatus  @default(ACTIVE)
  passwordChangedAt  DateTime?   @db.Timestamptz(3) // tokens issued before this are refused
  twoFactorSecret    String?     @db.VarChar(255) // AES-256-GCM encrypted
  twoFactorEnabledAt DateTime?   @db.Timestamptz(3)
  lastLoginAt        DateTime?   @db.Timestamptz(3)
  deletedAt          DateTime?   @db.Timestamptz(3) // accounts are anonymised, not deleted (orders must remain)
  /// Wishlist price-drop emails (one-click unsubscribe turns this off).
  priceDropEmails    Boolean     @default(true)
  /// The last price-drop email: at most one a day.
  priceDropEmailedAt DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  oauthAccounts     OAuthAccount[]
  sessions          Session[]
  authTokens        AuthToken[]
  backupCodes       BackupCode[]
  trustedDevices    TrustedDevice[]
  securityEvents    SecurityEvent[]
  addresses         Address[]
  store             Store?          @relation("StoreOwner")
  storeFollows      StoreFollow[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  cart              Cart?
  orders            Order[]
  returnRequests    ReturnRequest[]
  reviewedDocuments StoreDocument[] @relation("DocumentReviewer")
  reviewedStores    Store[]         @relation("StoreReviewer")
  handledPayouts    Payout[]        @relation("PayoutHandler")
  handledRefunds    Refund[]        @relation("RefundHandler")
  reportedFlags     ProductFlag[]   @relation("FlagReporter")
  resolvedFlags     ProductFlag[]   @relation("FlagResolver")
  auditLogs         AuditLog[]

  @@index([role, status])
  @@map("users")
}

model OAuthAccount {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @db.Uuid
  provider       OAuthProvider
  providerUserId String        @db.VarChar(255) // Google's "sub": stable even if the Google email changes
  email          String?       @db.VarChar(254) // shown as "Connected as …"; refreshed at each Google sign-in
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider]) // at most one Google account per Vendora account
  @@map("oauth_accounts")
}

/// One row per signed-in device (refresh token). Rotation keeps the same familyId;
/// presenting an already-rotated token revokes the whole family (theft detection).
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(64) // SHA-256 hex
  familyId         String    @db.Uuid
  userAgent        String?   @db.VarChar(512)
  ipAddress        String?   @db.VarChar(45)
  location         String?   @db.VarChar(100)
  persistent       Boolean   @default(false) // "Keep me signed in": 30-day cookie; false = ends when the browser closes
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3) // fixed at sign-in; refreshing never extends it
  revokedAt        DateTime? @db.Timestamptz(3)
  revokedReason    String?   @db.VarChar(50) // rotated | logout | reuse_detected | password_changed | user_inactive

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

/// Email verification codes, password-reset links and email-change links — stored only as keyed hashes (HMAC-SHA256).
model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @db.VarChar(64)
  newEmail  String?       @db.VarChar(254) // EMAIL_CHANGE only
  attempts  Int           @default(0)
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model BackupCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(64)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

/// "Trust this device for 30 days" after two-step verification. The browser keeps a random token
/// in an httpOnly cookie; only its SHA-256 hash is stored. Password changes, resets and turning 2FA
/// off revoke them all.
model TrustedDevice {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  userAgent  String?   @db.VarChar(512)
  ipAddress  String?   @db.VarChar(45)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("trusted_devices")
}

model SecurityEvent {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @db.Uuid
  type      SecurityEventType
  ipAddress String?           @db.VarChar(45)
  userAgent String?           @db.VarChar(512)
  location  String?           @db.VarChar(100)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("security_events")
}

model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  label      String?  @db.VarChar(30)
  fullName   String   @db.VarChar(100)
  phone      String   @db.VarChar(20)
  region     String   @db.VarChar(100)
  province   String?  @db.VarChar(100) // null for Metro Manila
  city       String   @db.VarChar(100)
  barangay   String   @db.VarChar(100)
  street     String   @db.VarChar(255)
  postalCode String   @db.VarChar(10)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ============================ 2 · stores ============================

model Store {
  id             String       @id @default(uuid(7)) @db.Uuid
  ownerId        String       @unique @db.Uuid // one store per seller account
  name           String       @db.VarChar(80)
  slug           String       @unique @db.VarChar(80)
  description    String?      @db.Text
  logoUrl        String?      @db.VarChar(500)
  /// The logo's storage id (Cloudinary), so a replaced logo can be deleted.
  logoPublicId   String?      @db.VarChar(255)
  bannerUrl      String?      @db.VarChar(500)
  status         StoreStatus  @default(DRAFT)
  /// What the store sells: a top-level category, chosen in onboarding step 1.
  categoryId     String?      @db.Uuid
  /// When it was submitted for review (every store past DRAFT has one; CHECK).
  submittedAt    DateTime?    @db.Timestamptz(3)
  businessType   BusinessType
  legalName      String?      @db.VarChar(150)
  registrationNo String?      @db.VarChar(50) // DTI / SEC
  tinEncrypted   String?      @db.VarChar(255)
  shipsFrom      String?      @db.VarChar(100)
  ratingAvg      Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount    Int          @default(0)
  followerCount  Int          @default(0)
  warningCount   Int          @default(0)
  approvedAt     DateTime?    @db.Timestamptz(3)
  /// The latest review of the application (7a): the note sent to the seller (required for changes/reject: CHECK).
  reviewNote     String?      @db.VarChar(1000)
  reviewedAt     DateTime?    @db.Timestamptz(3)
  reviewedById   String?      @db.Uuid
  suspendedUntil DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  owner         User              @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewedBy    User?             @relation("StoreReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  documents     StoreDocument[]
  payoutAccount PayoutAccount?
  followers     StoreFollow[]
  products      Product[]
  variants      ProductVariant[]
  sellerOrders  SellerOrder[]
  ledgerEntries LedgerEntry[]
  payouts       Payout[]
  dailyVisits   StoreDailyVisit[]

  @@index([status])
  @@index([categoryId])
  @@map("stores")
}

model StoreDocument {
  id           String         @id @default(uuid(7)) @db.Uuid
  storeId      String         @db.Uuid
  type         DocumentType
  fileKey      String         @db.VarChar(255) // private storage key, never a public URL
  /// Read from the storage service after upload, never from the browser.
  format       String?        @db.VarChar(10)
  bytes        Int?
  status       DocumentStatus @default(PENDING)
  reviewedById String?        @db.Uuid
  note         String?        @db.VarChar(500)
  reviewedAt   DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@map("store_documents")
}

/// Unique visitors per store per Philippine day (store page + its product pages), copied nightly from Redis (6d).
model StoreDailyVisit {
  storeId String   @db.Uuid
  day     DateTime @db.Date
  visits  Int // ≥ 0 (CHECK)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day])
  @@map("store_daily_visits")
}

model PayoutAccount {
  id                     String       @id @default(uuid(7)) @db.Uuid
  storeId                String       @unique @db.Uuid
  method                 PayoutMethod
  /// BANK only (CHECK): one of the banks in the allow-list.
  bankName               String?      @db.VarChar(60)
  accountName            String       @db.VarChar(100)
  accountNumberEncrypted String       @db.VarChar(255)
  last4                  String       @db.VarChar(4)
  verifiedAt             DateTime?    @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

model StoreFollow {
  userId    String   @db.Uuid
  storeId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
  @@map("store_follows")
}

// ============================ 3 · catalog ============================

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  parentId  String?  @db.Uuid
  name      String   @db.VarChar(80)
  slug      String   @unique @db.VarChar(80)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]
  stores   Store[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String                   @id @default(uuid(7)) @db.Uuid
  storeId          String                   @db.Uuid
  categoryId       String                   @db.Uuid
  title            String                   @db.VarChar(200)
  slug             String                   @db.VarChar(220)
  description      String                   @db.Text
  /// "Specifications" tab: [{ "label": "Battery life", "value": "30 hours" }, …] (max 30, CHECK)
  specs            Json                     @default("[]")
  /// Full-text search: title (weight A) + description (weight B). Generated by PostgreSQL, see migration 20261120090000_catalog_search.
  searchVector     Unsupported("tsvector")?
  status           ProductStatus            @default(DRAFT)
  ratingAvg        Decimal                  @default(0) @db.Decimal(3, 2)
  ratingCount      Int                      @default(0)
  soldCount        Int                      @default(0)
  publishedAt      DateTime?                @db.Timestamptz(3)
  /// What the variants differ by: "Color", "Size", "Model" (one option per product).
  variantLabel     String                   @default("Color") @db.VarChar(30)
  /// "Offer Express delivery": a package can go Express only if every item in it allows it.
  expressAvailable Boolean                  @default(true)
  /// "Alert me when a variant has fewer than 10 left" (the email comes with seller orders, 6c).
  lowStockAlert    Boolean                  @default(true)
  /// Raised by every seller edit; an edit from an out-of-date form is refused (orders and reviews don't change it).
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)

  store         Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  flags         ProductFlag[]

  @@unique([storeId, slug])
  @@index([categoryId, status])
  @@index([storeId, status])
  @@index([status, soldCount(sort: Desc)])
  @@map("products")
}

model ProductVariant {
  id                String    @id @default(uuid(7)) @db.Uuid
  productId         String    @db.Uuid
  storeId           String    @db.Uuid // copied from the product so a SKU is unique per store
  sku               String    @db.VarChar(64)
  name              String    @db.VarChar(100) // "Midnight Black"
  priceCentavos     Int
  compareAtCentavos Int? // crossed-out price, must be higher than the price
  /// Deal countdown: after this time the deal is over and the variant sells at compareAtCentavos again.
  saleEndsAt        DateTime? @db.Timestamptz(3)
  stock             Int       @default(0) // never below 0 (CHECK)
  weightGrams       Int?
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  /// Low-stock emails: when the seller was told it's below 10 (or set it that low themselves); cleared once restocked.
  lowStockAlertedAt DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([storeId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.VarChar(500)
  publicId  String?  @unique @db.VarChar(255) // Cloudinary id, for deleting (null for the demo photos)
  alt       String?  @db.VarChar(200)
  sortOrder Int      @default(0) // 0 = cover photo
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Only buyers can review: one review per purchased order item.
model Review {
  id           String       @id @default(uuid(7)) @db.Uuid
  productId    String       @db.Uuid
  userId       String       @db.Uuid
  orderItemId  String       @unique @db.Uuid
  rating       Int // 1–5 (CHECK)
  title        String?      @db.VarChar(120)
  body         String?      @db.Text
  helpfulCount Int          @default(0)
  status       ReviewStatus @default(PUBLISHED)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([productId, status, createdAt(sort: Desc)])
  @@index([userId])
  @@map("reviews")
}

model WishlistItem {
  userId                String   @db.Uuid
  productId             String   @db.Uuid
  priceAtSaveCentavos   Int // to detect price drops
  /// The price we last emailed about; another email needs a lower price (reset when the drop is over).
  notifiedPriceCentavos Int?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// ==================== 4 · cart, orders & payments ====================

/// Signed-in cart. Guests keep their cart in the browser; it merges into this one at sign-in.
model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartId             String   @db.Uuid
  variantId          String   @db.Uuid
  quantity           Int // 1–99 (CHECK)
  /// The price the shopper last saw for this line ("Price changed since you added it"); null = unknown.
  priceAtAddCentavos Int?
  addedAt            DateTime @default(now()) @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

/// One checkout. Shown to shoppers as "VD-" + orderNumber (starts at 21000).
model Order {
  id               String        @id @default(uuid(7)) @db.Uuid
  orderNumber      Int           @unique @default(autoincrement())
  userId           String        @db.Uuid
  status           OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod    PaymentMethod
  subtotalCentavos Int
  deliveryCentavos Int
  discountCentavos Int           @default(0)
  totalCentavos    Int // = subtotal + delivery − discount (CHECK)
  shippingAddress  Json // snapshot of the address at checkout
  placedAt         DateTime?     @db.Timestamptz(3) // when payment succeeded (or COD confirmed)
  expiresAt        DateTime?     @db.Timestamptz(3) // unpaid orders release their stock after this
  cancelledAt      DateTime?     @db.Timestamptz(3)
  /// "Place order" sent twice gives one order: unique per shopper (milestone 5b).
  idempotencyKey   String?       @db.VarChar(64)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sellerOrders SellerOrder[]
  payments     Payment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("orders")
}

/// The part of an order that one store ships ("3 packages" = 3 seller orders).
model SellerOrder {
  id                  String                @id @default(uuid(7)) @db.Uuid
  orderId             String                @db.Uuid
  storeId             String                @db.Uuid
  status              SellerOrderStatus     @default(AWAITING_PAYMENT)
  deliveryOption      DeliveryOption        @default(STANDARD)
  subtotalCentavos    Int
  deliveryCentavos    Int
  platformFeeCentavos Int                   @default(0) // 5% (0% in a store's first 30 days)
  /// Set when shipping (CHECK: every shipped package has courier, tracking number and shippedAt).
  courier             String?               @db.VarChar(60)
  /// Stored as letters and digits only ("7720 1934-5512" → "772019345512"); unique per courier.
  trackingNumber      String?               @db.VarChar(60)
  /// Optional, from "Mark as shipped"; printed on the packing slip.
  packageWeightGrams  Int?
  /// 6:00 PM Manila, 2 days after payment.
  shipBy              DateTime?             @db.Timestamptz(3)
  shippedAt           DateTime?             @db.Timestamptz(3)
  deliveredAt         DateTime?             @db.Timestamptz(3)
  deliveryConfirmedBy DeliveryConfirmation?
  cancelledAt         DateTime?             @db.Timestamptz(3)
  /// Who cancelled a paid package and why (both or neither; only on CANCELLED packages: CHECK).
  cancelledBy         CancelledBy?
  cancelReason        CancelReason?
  /// The seller was emailed "VD-21458 is late" (at ship-by) / "cancelled tomorrow" (a day before the automatic cancel).
  lateNotifiedAt      DateTime?             @db.Timestamptz(3)
  cancelWarnedAt      DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  events         ShipmentEvent[]
  returnRequests ReturnRequest[]
  ledgerEntries  LedgerEntry[]
  refund         Refund?

  @@unique([orderId, storeId])
  @@unique([courier, trackingNumber])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([status, shippedAt])
  @@index([status, shipBy])
  @@map("seller_orders")
}

model OrderItem {
  id                String   @id @default(uuid(7)) @db.Uuid
  sellerOrderId     String   @db.Uuid
  variantId         String   @db.Uuid
  productId         String   @db.Uuid
  productTitle      String   @db.VarChar(200) // snapshot
  variantName       String   @db.VarChar(100) // snapshot
  imageUrl          String?  @db.VarChar(500) // snapshot
  unitPriceCentavos Int // snapshot
  quantity          Int // > 0 (CHECK)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  sellerOrder SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  review      Review?

  @@index([sellerOrderId])
  @@index([variantId])
  @@index([productId])
  @@map("order_items")
}

model ShipmentEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  sellerOrderId String   @db.Uuid
  status        String   @db.VarChar(40)
  message       String   @db.VarChar(255)
  location      String?  @db.VarChar(100)
  occurredAt    DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  @@index([sellerOrderId, occurredAt])
  @@map("shipment_events")
}

model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  orderId           String          @db.Uuid
  provider          PaymentProvider
  method            PaymentMethod
  providerRef       String?         @unique @db.VarChar(100) // PayMongo checkout session id (cs_…); null for COD
  amountCentavos    Int // > 0 (CHECK)
  status            PaymentStatus   @default(PENDING)
  /// The PayMongo payment that settled this attempt (pay_…), needed for refunds.
  providerPaymentId String?         @unique @db.VarChar(100)
  /// PayMongo's hosted page for this attempt ("Continue to payment").
  checkoutUrl       String?         @db.VarChar(500)
  failureReason     String?         @db.VarChar(255)
  paidAt            DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

/// Money going back to a shopper through PayMongo. Saved BEFORE it's sent, with its id in PayMongo's
/// metadata, so a retry first asks PayMongo whether it already went through (never sent twice).
model Refund {
  id               String         @id @default(uuid(7)) @db.Uuid
  paymentId        String         @db.Uuid
  /// The cancelled package (one refund per package); null for whole-payment refunds.
  sellerOrderId    String?        @unique @db.Uuid
  amountCentavos   Int // > 0 (CHECK); all of a payment's refunds add up to at most what was paid
  reason           RefundReason
  status           RefundStatus   @default(PENDING)
  /// PayMongo's refund id (ref_…) once sent.
  providerRefundId String?        @unique @db.VarChar(100)
  attempts         Int            @default(0)
  /// When to (re)try; a claim moves it an hour ahead first, so two runs never send it at once.
  nextAttemptAt    DateTime?      @db.Timestamptz(3)
  lastError        String?        @db.VarChar(255)
  sentAt           DateTime?      @db.Timestamptz(3)
  /// Set when SENT (CHECK: PayMongo ways have providerRefundId, OTHER_TRANSFER has manualReference).
  sentVia          RefundSentVia?
  /// The other transfer's reference (a GCash or bank reference number), entered by the admin.
  manualReference  String?        @db.VarChar(100)
  /// The admin who closed it by hand (milestone 7b); null for automatic refunds.
  handledById      String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  handledBy   User?        @relation("RefundHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status, nextAttemptAt])
  @@map("refunds")
}

/// Every payment webhook is stored once — a repeated delivery can't be processed twice.
model WebhookEvent {
  id              String          @id @default(uuid(7)) @db.Uuid
  provider        PaymentProvider
  providerEventId String          @db.VarChar(100)
  type            String          @db.VarChar(80)
  payload         Json
  receivedAt      DateTime        @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?       @db.Timestamptz(3)
  error           String?         @db.VarChar(500)

  @@unique([provider, providerEventId])
  @@index([processedAt])
  @@map("webhook_events")
}

model ReturnRequest {
  id             String       @id @default(uuid(7)) @db.Uuid
  sellerOrderId  String       @db.Uuid
  userId         String       @db.Uuid
  reason         String       @db.VarChar(500)
  status         ReturnStatus @default(REQUESTED)
  refundCentavos Int          @default(0)
  resolvedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sellerOrderId])
  @@index([userId])
  @@map("return_requests")
}

// ==================== 5 · seller money & admin ====================

/// A store's balance = SUM(amountCentavos) of its entries; money becomes available at availableAt.
/// A package gets one SALE and at most one FEE (partial unique index, in the migration only).
model LedgerEntry {
  id             String     @id @default(uuid(7)) @db.Uuid
  storeId        String     @db.Uuid
  sellerOrderId  String?    @db.Uuid
  payoutId       String?    @db.Uuid
  type           LedgerType
  amountCentavos Int // + money in, − money out; never 0 (CHECK)
  description    String?    @db.VarChar(200)
  availableAt    DateTime   @db.Timestamptz(3) // delivery + 7 days for sales
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  payout      Payout?      @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([storeId, availableAt])
  @@index([sellerOrderId])
  @@index([payoutId])
  @@map("ledger_entries")
}

/// Money sent to a seller: all their available ledger lines at that moment. One PROCESSING payout per store
/// (partial unique index, migration only); PAID has paidAt and its transfer reference, FAILED a reason (CHECK).
/// A Finance admin makes the transfer and marks it paid or failed (milestone 7b).
model Payout {
  id                String       @id @default(uuid(7)) @db.Uuid
  storeId           String       @db.Uuid
  reference         String       @unique @db.VarChar(30) // PO-2026-1117
  amountCentavos    Int // > 0 (CHECK)
  method            PayoutMethod
  accountLast4      String       @db.VarChar(4)
  /// The history row: orders, gross sales and Vendora's fees in it (written when it's made).
  orderCount        Int          @default(0)
  grossCentavos     Int          @default(0)
  feesCentavos      Int          @default(0)
  status            PayoutStatus @default(PROCESSING)
  failureReason     String?      @db.VarChar(255)
  paidAt            DateTime?    @db.Timestamptz(3)
  /// The bank or GCash transfer's reference number, shown to the seller (required for PAID: CHECK).
  transferReference String?      @db.VarChar(100)
  /// The Finance admin who marked it paid or failed.
  handledById       String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  handledBy     User?         @relation("PayoutHandler", fields: [handledById], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@index([storeId, createdAt(sort: Desc)])
  @@map("payouts")
}

model ProductFlag {
  id             String     @id @default(uuid(7)) @db.Uuid
  productId      String     @db.Uuid
  source         FlagSource
  reason         String     @db.VarChar(255)
  message        String?    @db.Text
  riskScore      Int? // 0–100, AI only (CHECK)
  status         FlagStatus @default(OPEN)
  reporterId     String?    @db.Uuid
  resolvedById   String?    @db.Uuid
  resolvedAt     DateTime?  @db.Timestamptz(3)
  resolutionNote String?    @db.VarChar(500)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter   User?   @relation("FlagReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User?   @relation("FlagResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([productId])
  @@map("product_flags")
}

/// Every admin action (and sensitive system action) is recorded here.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid // null = system
  action     String   @db.VarChar(60) // store.approve, store.view_tin, payout_account.verify…
  targetType String   @db.VarChar(40)
  targetId   String?  @db.Uuid
  metadata   Json?
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
